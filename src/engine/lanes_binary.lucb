func shl_i32(d: i32[], a: const i32[], b: const i32[], on: Active) -> usize:
    for i in 0..<d.length:
        if b[i] < 0 or b[i] >= 32:
            if on.at(i): return i
            d[i] = 0
        else:
            d[i] = a[i] << b[i]
    return d.length

