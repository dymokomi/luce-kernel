func add_i32(d: i32[], a: const i32[], b: const i32[], on: Active) -> usize:
    for i in 0..<d.length:
        if let value = a[i] +? b[i]:
            d[i] = value
        else:
            if on.at(i): return i
            d[i] = a[i] +% b[i]
    return d.length

