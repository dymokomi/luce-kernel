func add_f32(d: f32[], a: const f32[], b: const f32[]):
    assert(a.length == d.length and b.length == d.length)
    for i in 0..<d.length: d[i] = a[i] + b[i]

func add_f64(d: f64[], a: const f64[], b: const f64[]):
