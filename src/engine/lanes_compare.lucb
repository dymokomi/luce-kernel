                _: return w.n
        .clamp:
            match ins.kind:
                .f32: clamp_f32(w.f32s(ins.dst), w.f32s(ins.a), w.f32s(ins.b), w.f32s(ins.c))
                .f64: clamp_f64(w.f64s(ins.dst), w.f64s(ins.a), w.f64s(ins.b), w.f64s(ins.c))
                .i32: clamp_i32(w.i32s(ins.dst), w.i32s(ins.a), w.i32s(ins.b), w.i32s(ins.c))
                .i64: clamp_i64(w.i64s(ins.dst), w.i64s(ins.a), w.i64s(ins.b), w.i64s(ins.c))
                .u32: clamp_u32(w.u32s(ins.dst), w.u32s(ins.a), w.u32s(ins.b), w.u32s(ins.c))
                .u64: clamp_u64(w.u64s(ins.dst), w.u64s(ins.a), w.u64s(ins.b), w.u64s(ins.c))
                _: return w.n
        .smooth:
            match ins.kind:
                .f32: smooth_f32(w.f32s(ins.dst), w.f32s(ins.a), w.f32s(ins.b), w.f32s(ins.c))
                .f64: smooth_f64(w.f64s(ins.dst), w.f64s(ins.a), w.f64s(ins.b), w.f64s(ins.c))
                _: return w.n
        .fit01:
            match ins.kind:
