                .f64: fit01_f64(w.f64s(ins.dst), w.f64s(ins.a), w.f64s(ins.b), w.f64s(ins.c))
                _: return w.n
        _: return w.n
    return w.n

func eq_f32(d: u8[], a: const f32[], b: const f32[]):
    assert(a.length == d.length and b.length == d.length)
    var i: usize = 0
    while i < d.length:
        d[i] = (u8)(a[i] == b[i])
        i += 1

