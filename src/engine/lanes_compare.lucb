# Generated by tools/lanes.py from its tables; edit those, not this file.
# Compares (mask results) and ternary lane operations.
# LUCE-BUG: loops that cannot fault are `while` loops after a length assert, the form
# the --opt 3 vectorizer takes (it skips `for i in 0..<n`); see tools/lanes.py.

## Run a compare or ternary instruction; never faults.
func compare_or_ternary(w: Worker*, ins: Instruction) -> usize:
    match ins.op:
        .eq:
            match ins.kind:
                .f32: eq_f32(w.masks(ins.dst), w.f32s(ins.a), w.f32s(ins.b))
                .f64: eq_f64(w.masks(ins.dst), w.f64s(ins.a), w.f64s(ins.b))
                .i32: eq_i32(w.masks(ins.dst), w.i32s(ins.a), w.i32s(ins.b))
                .i64: eq_i64(w.masks(ins.dst), w.i64s(ins.a), w.i64s(ins.b))
                .u32: eq_u32(w.masks(ins.dst), w.u32s(ins.a), w.u32s(ins.b))
                .u64: eq_u64(w.masks(ins.dst), w.u64s(ins.a), w.u64s(ins.b))
                .mask: eq_mask(w.masks(ins.dst), w.masks(ins.a), w.masks(ins.b))
                _: return w.n
        .ne:
            match ins.kind:
                .f32: ne_f32(w.masks(ins.dst), w.f32s(ins.a), w.f32s(ins.b))
                .f64: ne_f64(w.masks(ins.dst), w.f64s(ins.a), w.f64s(ins.b))
                .i32: ne_i32(w.masks(ins.dst), w.i32s(ins.a), w.i32s(ins.b))
                .i64: ne_i64(w.masks(ins.dst), w.i64s(ins.a), w.i64s(ins.b))
                .u32: ne_u32(w.masks(ins.dst), w.u32s(ins.a), w.u32s(ins.b))
                .u64: ne_u64(w.masks(ins.dst), w.u64s(ins.a), w.u64s(ins.b))
                .mask: ne_mask(w.masks(ins.dst), w.masks(ins.a), w.masks(ins.b))
                _: return w.n
        .lt:
            match ins.kind:
                .f32: lt_f32(w.masks(ins.dst), w.f32s(ins.a), w.f32s(ins.b))
                .f64: lt_f64(w.masks(ins.dst), w.f64s(ins.a), w.f64s(ins.b))
                .i32: lt_i32(w.masks(ins.dst), w.i32s(ins.a), w.i32s(ins.b))
                .i64: lt_i64(w.masks(ins.dst), w.i64s(ins.a), w.i64s(ins.b))
                .u32: lt_u32(w.masks(ins.dst), w.u32s(ins.a), w.u32s(ins.b))
                .u64: lt_u64(w.masks(ins.dst), w.u64s(ins.a), w.u64s(ins.b))
                _: return w.n
        .le:
            match ins.kind:
                .f32: le_f32(w.masks(ins.dst), w.f32s(ins.a), w.f32s(ins.b))
                .f64: le_f64(w.masks(ins.dst), w.f64s(ins.a), w.f64s(ins.b))
                .i32: le_i32(w.masks(ins.dst), w.i32s(ins.a), w.i32s(ins.b))
                .i64: le_i64(w.masks(ins.dst), w.i64s(ins.a), w.i64s(ins.b))
                .u32: le_u32(w.masks(ins.dst), w.u32s(ins.a), w.u32s(ins.b))
                .u64: le_u64(w.masks(ins.dst), w.u64s(ins.a), w.u64s(ins.b))
                _: return w.n
        .gt:
            match ins.kind:
                .f32: gt_f32(w.masks(ins.dst), w.f32s(ins.a), w.f32s(ins.b))
                .f64: gt_f64(w.masks(ins.dst), w.f64s(ins.a), w.f64s(ins.b))
                .i32: gt_i32(w.masks(ins.dst), w.i32s(ins.a), w.i32s(ins.b))
                .i64: gt_i64(w.masks(ins.dst), w.i64s(ins.a), w.i64s(ins.b))
                .u32: gt_u32(w.masks(ins.dst), w.u32s(ins.a), w.u32s(ins.b))
                .u64: gt_u64(w.masks(ins.dst), w.u64s(ins.a), w.u64s(ins.b))
                _: return w.n
        .ge:
            match ins.kind:
                .f32: ge_f32(w.masks(ins.dst), w.f32s(ins.a), w.f32s(ins.b))
                .f64: ge_f64(w.masks(ins.dst), w.f64s(ins.a), w.f64s(ins.b))
                .i32: ge_i32(w.masks(ins.dst), w.i32s(ins.a), w.i32s(ins.b))
                .i64: ge_i64(w.masks(ins.dst), w.i64s(ins.a), w.i64s(ins.b))
                .u32: ge_u32(w.masks(ins.dst), w.u32s(ins.a), w.u32s(ins.b))
                .u64: ge_u64(w.masks(ins.dst), w.u64s(ins.a), w.u64s(ins.b))
                _: return w.n
        .mul_add:
            match ins.kind:
                .f32: mul_add_f32(w.f32s(ins.dst), w.f32s(ins.a), w.f32s(ins.b), w.f32s(ins.c))
                .f64: mul_add_f64(w.f64s(ins.dst), w.f64s(ins.a), w.f64s(ins.b), w.f64s(ins.c))
                _: return w.n
        .lerp:
            match ins.kind:
