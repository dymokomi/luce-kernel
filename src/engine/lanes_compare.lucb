func clamp_f32(d: f32[], a: const f32[], b: const f32[], c: const f32[]):
    assert(a.length == d.length and b.length == d.length and c.length == d.length)
    var i: usize = 0
    while i < d.length:
        d[i] = b[i] if a[i] < b[i] else (c[i] if a[i] > c[i] else a[i])
        i += 1

