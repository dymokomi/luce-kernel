func neg_f32(d: f32[], a: const f32[]):
    for i in 0..<d.length: d[i] = -a[i]

func neg_f64(d: f64[], a: const f64[]):
    for i in 0..<d.length: d[i] = -a[i]

func neg_i32(d: i32[], a: const i32[], on: Active) -> usize:
    for i in 0..<d.length:
        if a[i] == (-2147483648):
            if on.at(i): return i
            d[i] = a[i]
        else:
            d[i] = -a[i]
    return d.length

