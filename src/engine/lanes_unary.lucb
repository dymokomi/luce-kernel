func abs_i32(d: i32[], a: const i32[], on: Active) -> usize:
    for i in 0..<d.length:
        if a[i] == (-2147483648):
            if on.at(i): return i
            d[i] = a[i]
        else:
            d[i] = a[i] if a[i] >= 0 else -a[i]
    return d.length

