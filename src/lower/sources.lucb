let source_texts: str[9] = [
    "module.lucb\ninterpolate.lucb\nvector.lucb\nrandom.lucb\nnoise.lucb\nperlin.lucb\n",
    "#==============================================================================================\n#\n#   lib - The functions a Code node's snippet calls without importing them\n#\n#   DESCRIPTION:\n#       VEX's general library in Base spelling: vector functions over `f32[4]` (a\n#       three-component value keeps lane 3 at zero), interpolation and fitting, hash-based\n#       random numbers and Perlin noise, each in the widths it supports. f64 forms carry a\n#       `64` suffix and two-component forms a `2d` suffix, since Base has no overloading.\n#\n#       The node never calls these bodies: the lowering recognizes each name and runs the\n#       engine's column operation for it. They are the same computation lane for lane, so a\n#       snippet means what it would mean as plain Base, and the engine's tests check its\n#       columns against them.\n#\n#==============================================================================================\nfrom luce_std import math, math32\n",
    "# Interpolation, fitting and angle units.\n\n## `a` moved toward `b` by `t`: `a + (b - a) * t` (VEX `lerp`).\npub func lerp(a: f32, b: f32, t: f32) -> f32:\n    return a + (b - a) * t\n\n## `lerp` in f64.\npub func lerp64(a: f64, b: f64, t: f64) -> f64:\n    return a + (b - a) * t\n\n## `x` held to `low..high`: `low` below it, `high` above it, `x` itself (a NaN included)\n## otherwise.\npub func clamp(x: f32, low: f32, high: f32) -> f32:\n    return low if x < low else (high if x > high else x)\n\n## `clamp` in f64.\npub func clamp64(x: f64, low: f64, high: f64) -> f64:\n    return low if x < low else (high if x > high else x)\n\n## `x` clamped to `0..1` and mapped onto `new_low..new_high` (VEX `fit01`).\npub func fit01(x: f32, new_low: f32, new_high: f32) -> f32:\n    return lerp(new_low, new_high, clamp(x, 0.0, 1.0))\n\n## `fit01` in f64.\npub func fit01_64(x: f64, new_low: f64, new_high: f64) -> f64:\n    return lerp64(new_low, new_high, clamp64(x, 0.0, 1.0))\n\n## `x` clamped to the old range and mapped onto the new one (VEX `fit`). A reversed old\n## range maps in reverse; an empty one maps everything to `new_low`.\npub func fit(x: f32, old_low: f32, old_high: f32, new_low: f32, new_high: f32) -> f32:\n    if old_low == old_high:\n        return new_low\n    let held = clamp(x, old_low, old_high) if old_low < old_high else clamp(x, old_high, old_low)\n    return lerp(new_low, new_high, (held - old_low) / (old_high - old_low))\n\n## `fit` in f64.\npub func fit64(x: f64, old_low: f64, old_high: f64, new_low: f64, new_high: f64) -> f64:\n    if old_low == old_high:\n        return new_low\n    let held = clamp64(x, old_low, old_high) if old_low < old_high else clamp64(x, old_high, old_low)\n    return lerp64(new_low, new_high, (held - old_low) / (old_high - old_low))\n\n## 0 at or below `low`, 1 at or above `high`, and the smooth Hermite rise\n## `t * t * (3 - 2 * t)` between (VEX `smooth`).\npub func smooth(low: f32, high: f32, x: f32) -> f32:\n    if x <= low: return 0.0\n    if x >= high: return 1.0\n    let t = (x - low) / (high - low)\n    return t * t * (3.0 - 2.0 * t)\n\n## `smooth` in f64.\npub func smooth64(low: f64, high: f64, x: f64) -> f64:\n    if x <= low: return 0.0\n    if x >= high: return 1.0\n    let t = (x - low) / (high - low)\n    return t * t * (3.0 - 2.0 * t)\n\n## Radians to degrees.\npub func degrees(radians_value: f32) -> f32:\n    return radians_value * (180.0 / math32.pi)\n\n## `degrees` in f64.\npub func degrees64(radians_value: f64) -> f64:\n    return radians_value * (180.0 / math.pi)\n\n## Degrees to radians.\npub func radians(degrees_value: f32) -> f32:\n    return degrees_value * (math32.pi / 180.0)\n\n## `radians` in f64.\npub func radians64(degrees_value: f64) -> f64:\n    return degrees_value * (math.pi / 180.0)\n",
    "# Vector functions. An `f32[4]` holding a position, normal or color keeps lane 3 at zero,\n# so the four-lane forms are VEX's three-component ones.\n\n## The dot product of all four lanes.\npub func dot(a: f32[4], b: f32[4]) -> f32:\n    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3]\n\n## The cross product of lanes 0 to 2; lane 3 of the result is zero.\npub func cross(a: f32[4], b: f32[4]) -> f32[4]:\n    return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0], 0.0]\n\n## The length.\npub func length(a: f32[4]) -> f32:\n    return math32.sqrt(dot(a, a))\n\n## The squared length.\npub func length2(a: f32[4]) -> f32:\n    return dot(a, a)\n\n## The distance between two points.\npub func distance(a: f32[4], b: f32[4]) -> f32:\n    return length(a - b)\n\n## The squared distance between two points.\npub func distance2(a: f32[4], b: f32[4]) -> f32:\n    return length2(a - b)\n\n## `a` scaled to length 1; a zero vector stays zero.\npub func normalized(a: f32[4]) -> f32[4]:\n    let size = length(a)\n    if size == 0.0:\n        return f32[4](0.0)\n    return a * (1.0 / size)\n\n## The dot product of a two-lane vector.\npub func dot2d(a: f32[2], b: f32[2]) -> f32:\n    return a[0] * b[0] + a[1] * b[1]\n\n## The length of a two-lane vector.\npub func length2d(a: f32[2]) -> f32:\n    return math32.sqrt(dot2d(a, a))\n\n## The distance between two two-lane points.\npub func distance2d(a: f32[2], b: f32[2]) -> f32:\n    return length2d(a - b)\n\n## A two-lane vector scaled to length 1; zero stays zero.\npub func normalized2d(a: f32[2]) -> f32[2]:\n    let size = length2d(a)\n    if size == 0.0:\n        return f32[2](0.0)\n    return a * (1.0 / size)\n\n## The dot product of four f64 lanes.\npub func dot64(a: f64[4], b: f64[4]) -> f64:\n    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3]\n\n## The cross product of f64 lanes 0 to 2; lane 3 of the result is zero.\npub func cross64(a: f64[4], b: f64[4]) -> f64[4]:\n    return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0], 0.0]\n\n## The length of an f64 vector.\npub func length64(a: f64[4]) -> f64:\n    return math.sqrt(dot64(a, a))\n\n## The squared length of an f64 vector.\npub func length2_64(a: f64[4]) -> f64:\n    return dot64(a, a)\n\n## The distance between two f64 points.\npub func distance64(a: f64[4], b: f64[4]) -> f64:\n    return length64(difference64(a, b))\n\n## The squared distance between two f64 points.\npub func distance2_64(a: f64[4], b: f64[4]) -> f64:\n    return length2_64(difference64(a, b))\n\n## An f64 vector scaled to length 1; zero stays zero.\npub func normalized64(a: f64[4]) -> f64[4]:\n    let size = length64(a)\n    if size == 0.0:\n        return [0.0, 0.0, 0.0, 0.0]\n    let scale = 1.0 / size\n    return [a[0] * scale, a[1] * scale, a[2] * scale, a[3] * scale]\n\n# `a - b` lane by lane (`f64[4]` is an array, not a vector, so it has no `-`).\nfunc difference64(a: f64[4], b: f64[4]) -> f64[4]:\n    return [a[0] - b[0], a[1] - b[1], a[2] - b[2], a[3] - b[3]]\n",
    "# Hash-based random numbers: pure functions of their seed, so every element, run, thread\n# count and machine gets the same values (a per-element random is `rand(index + seed)`).\n\n## A random number in `[0, 1)` for `seed` (VEX `rand`).\npub func rand(seed: i64) -> f32:\n    return rand_stream(seed, 0)\n\n## `rand` in f64, with 53 random bits.\npub func rand64(seed: i64) -> f64:\n    return rand_stream64(seed, 0)\n\n## Three independent random numbers in `[0, 1)` for `seed`, lane 3 zero (VEX `rand` of a\n## vector); lane `k` is `rand_stream(seed, k)`.\npub func rand3(seed: i64) -> f32[4]:\n    return [rand_stream(seed, 0), rand_stream(seed, 1), rand_stream(seed, 2), 0.0]\n\n## The `stream`-th independent random number in `[0, 1)` for `seed`; stream 0 is `rand`.\npub func rand_stream(seed: i64, stream: u32) -> f32:\n    return (f32)(random_bits(seed, stream) >> 40) * (1.0 / 16777216.0)\n\n## `rand_stream` in f64.\npub func rand_stream64(seed: i64, stream: u32) -> f64:\n    return (f64)(random_bits(seed, stream) >> 11) * (1.0 / 9007199254740992.0)\n\n## 64 random bits for `seed` and `stream`: the SplitMix64 finalizer over the seed and a\n## stream offset (VEX `random_ihash`).\npub func random_bits(seed: i64, stream: u32) -> u64:\n    var z = (u64)seed +% (u64)stream *% 0xD1B54A32D192ED03 +% 0x9E3779B97F4A7C15\n    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9\n    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB\n    return z ^ (z >> 31)\n",
    "# Perlin noise, VEX's `noise` and `snoise`: `snoise` is signed, in `-1..1`, zero on the\n# integer lattice; `noise` is `0.5 + 0.5 * snoise`, in `0..1` centered on 0.5. Each comes\n# in 1 to 4 dimensions, computed in f32 or in f64. The 3D forms take an `f32[4]` and read\n# lanes 0 to 2.\n\n## Signed 1D noise.\npub func snoise1(x: f32) -> f32:\n    return limit(perlin1_32(x))\n\n## Signed 2D noise.\npub func snoise2(p: f32[2]) -> f32:\n    return limit(perlin2_32(p[0], p[1]))\n\n## Signed 3D noise of lanes 0 to 2.\npub func snoise(p: f32[4]) -> f32:\n    return limit(perlin3_32(p[0], p[1], p[2]))\n\n## Signed 4D noise.\npub func snoise4(p: f32[4]) -> f32:\n    return limit(perlin4_32(p[0], p[1], p[2], p[3]))\n\n## 1D noise in `0..1`.\npub func noise1(x: f32) -> f32:\n    return 0.5 + 0.5 * snoise1(x)\n\n## 2D noise in `0..1`.\npub func noise2(p: f32[2]) -> f32:\n    return 0.5 + 0.5 * snoise2(p)\n\n## 3D noise in `0..1` of lanes 0 to 2.\npub func noise(p: f32[4]) -> f32:\n    return 0.5 + 0.5 * snoise(p)\n\n## 4D noise in `0..1`.\npub func noise4(p: f32[4]) -> f32:\n    return 0.5 + 0.5 * snoise4(p)\n\n## Signed 1D noise in f64.\npub func snoise1_64(x: f64) -> f64:\n    return limit64(perlin1_64(x))\n\n## Signed 2D noise in f64.\npub func snoise2_64(p: f64[2]) -> f64:\n    return limit64(perlin2_64(p[0], p[1]))\n\n## Signed 3D noise in f64 of lanes 0 to 2.\npub func snoise64(p: f64[4]) -> f64:\n    return limit64(perlin3_64(p[0], p[1], p[2]))\n\n## Signed 4D noise in f64.\npub func snoise4_64(p: f64[4]) -> f64:\n    return limit64(perlin4_64(p[0], p[1], p[2], p[3]))\n\n## 1D noise in `0..1`, in f64.\npub func noise1_64(x: f64) -> f64:\n    return 0.5 + 0.5 * snoise1_64(x)\n\n## 2D noise in `0..1`, in f64.\npub func noise2_64(p: f64[2]) -> f64:\n    return 0.5 + 0.5 * snoise2_64(p)\n\n## 3D noise in `0..1`, in f64.\npub func noise64(p: f64[4]) -> f64:\n    return 0.5 + 0.5 * snoise64(p)\n\n## 4D noise in `0..1`, in f64.\npub func noise4_64(p: f64[4]) -> f64:\n    return 0.5 + 0.5 * snoise4_64(p)\n\n# The scaled lattice sums stay within -1..1 but for rounding; this makes it exact.\nfunc limit(value: f32) -> f32:\n    return -1.0 if value < -1.0 else (1.0 if value > 1.0 else value)\n\nfunc limit64(value: f64) -> f64:\n    return -1.0 if value < -1.0 else (1.0 if value > 1.0 else value)\n",
    "# Improved Perlin noise (Perlin 2002): quintic fade, a 256-entry permutation, and\n# gradients chosen from the hash's low bits, as in Stefan Gustavson's public-domain\n# noise1234. Each dimension's sum is scaled into -1..1. The f32 and f64 forms are the\n# same computation in their own width.\n\nlet permutation: u8[256] = [\n    151, 160, 137, 91, 90, 15, 131, 13, 201, 95, 96, 53, 194, 233, 7, 225, 140, 36, 103, 30,\n    69, 142, 8, 99, 37, 240, 21, 10, 23, 190, 6, 148, 247, 120, 234, 75, 0, 26, 197, 62, 94,\n    252, 219, 203, 117, 35, 11, 32, 57, 177, 33, 88, 237, 149, 56, 87, 174, 20, 125, 136, 171,\n    168, 68, 175, 74, 165, 71, 134, 139, 48, 27, 166, 77, 146, 158, 231, 83, 111, 229, 122, 60,\n    211, 133, 230, 220, 105, 92, 41, 55, 46, 245, 40, 244, 102, 143, 54, 65, 25, 63, 161, 1,\n    216, 80, 73, 209, 76, 132, 187, 208, 89, 18, 169, 200, 196, 135, 130, 116, 188, 159, 86,\n    164, 100, 109, 198, 173, 186, 3, 64, 52, 217, 226, 250, 124, 123, 5, 202, 38, 147, 118,\n    126, 255, 82, 85, 212, 207, 206, 59, 227, 47, 16, 58, 17, 182, 189, 28, 42, 223, 183, 170,\n    213, 119, 248, 152, 2, 44, 154, 163, 70, 221, 153, 101, 155, 167, 43, 172, 9, 129, 22, 39,\n    253, 19, 98, 108, 110, 79, 113, 224, 232, 178, 185, 112, 104, 218, 246, 97, 228, 251, 34,\n    242, 193, 238, 210, 144, 12, 191, 179, 162, 241, 81, 51, 145, 235, 249, 14, 239, 107, 49,\n    192, 214, 31, 181, 199, 106, 157, 184, 84, 204, 176, 115, 121, 50, 45, 127, 4, 150, 254,\n    138, 236, 205, 93, 222, 114, 67, 29, 24, 72, 243, 141, 128, 195, 78, 66, 215, 61, 156, 180,\n]\n\n# The hash of a lattice cell: each coordinate is reduced to 0..255 first.\nfunc mix(cell: usize, next: usize) -> usize:\n    return (usize)permutation[(cell + next) & 255]\n\nfunc lattice(value: i64) -> usize:\n    return (usize)(value & 255)\n\nfunc fade32(t: f32) -> f32:\n    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\nfunc fade64(t: f64) -> f64:\n    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)\n\n# Gradients: 1D slopes ±1..±8; 2D eight directions (±1, ±2) and (±2, ±1); 3D the twelve\n# cube edge directions (with four repeated); 4D the 32 directions with one zero lane.\nfunc grad1_32(hash_value: usize, x: f32) -> f32:\n    let slope = 1.0 + (f32)(hash_value & 7)\n    return -slope * x if (hash_value & 8) != 0 else slope * x\n\nfunc grad2_32(hash_value: usize, x: f32, y: f32) -> f32:\n    let h = hash_value & 7\n    let u = x if h < 4 else y\n    let v = y if h < 4 else x\n    return (-u if (h & 1) != 0 else u) + (-2.0 * v if (h & 2) != 0 else 2.0 * v)\n\nfunc grad3_32(hash_value: usize, x: f32, y: f32, z: f32) -> f32:\n    let h = hash_value & 15\n    let u = x if h < 8 else y\n    let v = y if h < 4 else (x if h == 12 or h == 14 else z)\n    return (-u if (h & 1) != 0 else u) + (-v if (h & 2) != 0 else v)\n\nfunc grad4_32(hash_value: usize, x: f32, y: f32, z: f32, t: f32) -> f32:\n    let h = hash_value & 31\n    let u = x if h < 24 else y\n    let v = y if h < 16 else z\n    let w = z if h < 8 else t\n    return (-u if (h & 1) != 0 else u) + (-v if (h & 2) != 0 else v) + (-w if (h & 4) != 0 else w)\n\nfunc grad1_64(hash_value: usize, x: f64) -> f64:\n    let slope = 1.0 + (f64)(hash_value & 7)\n    return -slope * x if (hash_value & 8) != 0 else slope * x\n\nfunc grad2_64(hash_value: usize, x: f64, y: f64) -> f64:\n    let h = hash_value & 7\n    let u = x if h < 4 else y\n    let v = y if h < 4 else x\n    return (-u if (h & 1) != 0 else u) + (-2.0 * v if (h & 2) != 0 else 2.0 * v)\n\nfunc grad3_64(hash_value: usize, x: f64, y: f64, z: f64) -> f64:\n    let h = hash_value & 15\n    let u = x if h < 8 else y\n    let v = y if h < 4 else (x if h == 12 or h == 14 else z)\n    return (-u if (h & 1) != 0 else u) + (-v if (h & 2) != 0 else v)\n\nfunc grad4_64(hash_value: usize, x: f64, y: f64, z: f64, t: f64) -> f64:\n    let h = hash_value & 31\n    let u = x if h < 24 else y\n    let v = y if h < 16 else z\n    let w = z if h < 8 else t\n    return (-u if (h & 1) != 0 else u) + (-v if (h & 2) != 0 else v) + (-w if (h & 4) != 0 else w)\n\n# One lattice coordinate: the cell (saturating for huge or NaN input) and the offset.\nfunc split32(x: f32) -> (usize, f32):\n    let floored = math32.floor(x)\n    return (lattice((i64)floored), x - floored)\n\nfunc split64(x: f64) -> (usize, f64):\n    let floored = math.floor(x)\n    return (lattice((i64)floored), x - floored)\n\nfunc perlin1_32(x: f32) -> f32:\n    let (ix, fx) = split32(x)\n    let s = fade32(fx)\n    let n0 = grad1_32(mix(ix, 0), fx)\n    let n1 = grad1_32(mix(ix + 1, 0), fx - 1.0)\n    return 0.188 * (n0 + s * (n1 - n0))\n\nfunc perlin2_32(x: f32, y: f32) -> f32:\n    let (ix, fx) = split32(x)\n    let (iy, fy) = split32(y)\n    let s = fade32(fx)\n    let t = fade32(fy)\n    let a = mix(ix, 0)\n    let b = mix(ix + 1, 0)\n    let n00 = grad2_32(mix(a, iy), fx, fy)\n    let n01 = grad2_32(mix(a, iy + 1), fx, fy - 1.0)\n    let n10 = grad2_32(mix(b, iy), fx - 1.0, fy)\n    let n11 = grad2_32(mix(b, iy + 1), fx - 1.0, fy - 1.0)\n    let n0 = n00 + t * (n01 - n00)\n    let n1 = n10 + t * (n11 - n10)\n    return 0.507 * (n0 + s * (n1 - n0))\n\nfunc perlin3_32(x: f32, y: f32, z: f32) -> f32:\n    let (ix, fx) = split32(x)\n    let (iy, fy) = split32(y)\n    let (iz, fz) = split32(z)\n    let r = fade32(fz)\n    let t = fade32(fy)\n    let s = fade32(fx)\n    let a = mix(ix, 0)\n    let b = mix(ix + 1, 0)\n    let aa = mix(a, iy)\n    let ab = mix(a, iy + 1)\n    let ba = mix(b, iy)\n    let bb = mix(b, iy + 1)\n    let x0 = blend32(r, grad3_32(mix(aa, iz), fx, fy, fz), grad3_32(mix(aa, iz + 1), fx, fy, fz - 1.0))\n    let x1 = blend32(r, grad3_32(mix(ab, iz), fx, fy - 1.0, fz), grad3_32(mix(ab, iz + 1), fx, fy - 1.0, fz - 1.0))\n    let x2 = blend32(r, grad3_32(mix(ba, iz), fx - 1.0, fy, fz), grad3_32(mix(ba, iz + 1), fx - 1.0, fy, fz - 1.0))\n    let x3 = blend32(r, grad3_32(mix(bb, iz), fx - 1.0, fy - 1.0, fz), grad3_32(mix(bb, iz + 1), fx - 1.0, fy - 1.0, fz - 1.0))\n    return 0.936 * blend32(s, blend32(t, x0, x1), blend32(t, x2, x3))\n\nfunc perlin4_32(x: f32, y: f32, z: f32, w: f32) -> f32:\n    let (ix, fx) = split32(x)\n    let (iy, fy) = split32(y)\n    let (iz, fz) = split32(z)\n    let (iw, fw) = split32(w)\n    let fade_x = fade32(fx)\n    let fade_y = fade32(fy)\n    let fade_z = fade32(fz)\n    let fade_w = fade32(fw)\n    var corners: f32[16]\n    for corner: usize in 0..<16:\n        let dx = corner & 1\n        let dy = (corner >> 1) & 1\n        let dz = (corner >> 2) & 1\n        let dw = (corner >> 3) & 1\n        let cell = mix(mix(mix(mix(ix + dx, 0), iy + dy), iz + dz), iw + dw)\n        corners[corner] = grad4_32(cell, fx - (f32)dx, fy - (f32)dy, fz - (f32)dz, fw - (f32)dw)\n    # Fold the 16 corners along w, then z, then y, then x.\n    for half: usize in 0..<8:\n        corners[half] = blend32(fade_w, corners[half], corners[half + 8])\n    for half: usize in 0..<4:\n        corners[half] = blend32(fade_z, corners[half], corners[half + 4])\n    for half: usize in 0..<2:\n        corners[half] = blend32(fade_y, corners[half], corners[half + 2])\n    return 0.87 * blend32(fade_x, corners[0], corners[1])\n\nfunc perlin1_64(x: f64) -> f64:\n    let (ix, fx) = split64(x)\n    let s = fade64(fx)\n    let n0 = grad1_64(mix(ix, 0), fx)\n    let n1 = grad1_64(mix(ix + 1, 0), fx - 1.0)\n    return 0.188 * (n0 + s * (n1 - n0))\n\nfunc perlin2_64(x: f64, y: f64) -> f64:\n    let (ix, fx) = split64(x)\n    let (iy, fy) = split64(y)\n    let s = fade64(fx)\n    let t = fade64(fy)\n    let a = mix(ix, 0)\n    let b = mix(ix + 1, 0)\n    let n00 = grad2_64(mix(a, iy), fx, fy)\n    let n01 = grad2_64(mix(a, iy + 1), fx, fy - 1.0)\n    let n10 = grad2_64(mix(b, iy), fx - 1.0, fy)\n    let n11 = grad2_64(mix(b, iy + 1), fx - 1.0, fy - 1.0)\n    let n0 = n00 + t * (n01 - n00)\n    let n1 = n10 + t * (n11 - n10)\n    return 0.507 * (n0 + s * (n1 - n0))\n\nfunc perlin3_64(x: f64, y: f64, z: f64) -> f64:\n    let (ix, fx) = split64(x)\n    let (iy, fy) = split64(y)\n    let (iz, fz) = split64(z)\n    let r = fade64(fz)\n    let t = fade64(fy)\n    let s = fade64(fx)\n    let a = mix(ix, 0)\n    let b = mix(ix + 1, 0)\n    let aa = mix(a, iy)\n    let ab = mix(a, iy + 1)\n    let ba = mix(b, iy)\n    let bb = mix(b, iy + 1)\n    let x0 = blend64(r, grad3_64(mix(aa, iz), fx, fy, fz), grad3_64(mix(aa, iz + 1), fx, fy, fz - 1.0))\n    let x1 = blend64(r, grad3_64(mix(ab, iz), fx, fy - 1.0, fz), grad3_64(mix(ab, iz + 1), fx, fy - 1.0, fz - 1.0))\n    let x2 = blend64(r, grad3_64(mix(ba, iz), fx - 1.0, fy, fz), grad3_64(mix(ba, iz + 1), fx - 1.0, fy, fz - 1.0))\n    let x3 = blend64(r, grad3_64(mix(bb, iz), fx - 1.0, fy - 1.0, fz), grad3_64(mix(bb, iz + 1), fx - 1.0, fy - 1.0, fz - 1.0))\n    return 0.936 * blend64(s, blend64(t, x0, x1), blend64(t, x2, x3))\n\nfunc perlin4_64(x: f64, y: f64, z: f64, w: f64) -> f64:\n    let (ix, fx) = split64(x)\n    let (iy, fy) = split64(y)\n    let (iz, fz) = split64(z)\n    let (iw, fw) = split64(w)\n    let fade_x = fade64(fx)\n    let fade_y = fade64(fy)\n    let fade_z = fade64(fz)\n    let fade_w = fade64(fw)\n    var corners: f64[16]\n    for corner: usize in 0..<16:\n        let dx = corner & 1\n        let dy = (corner >> 1) & 1\n        let dz = (corner >> 2) & 1\n        let dw = (corner >> 3) & 1\n        let cell = mix(mix(mix(mix(ix + dx, 0), iy + dy), iz + dz), iw + dw)\n        corners[corner] = grad4_64(cell, fx - (f64)dx, fy - (f64)dy, fz - (f64)dz, fw - (f64)dw)\n    for half: usize in 0..<8:\n        corners[half] = blend64(fade_w, corners[half], corners[half + 8])\n    for half: usize in 0..<4:\n        corners[half] = blend64(fade_z, corners[half], corners[half + 4])\n    for half: usize in 0..<2:\n        corners[half] = blend64(fade_y, corners[half], corners[half + 2])\n    return 0.87 * blend64(fade_x, corners[0], corners[1])\n\n# The lattice blend: `a` toward `b` by `t` (argument order of Perlin's reference).\nfunc blend32(t: f32, a: f32, b: f32) -> f32:\n    return a + t * (b - a)\n\nfunc blend64(t: f64, a: f64, b: f64) -> f64:\n    return a + t * (b - a)\n",
    "#==============================================================================================\n#\n#   math - The mathematical functions of the standard library\n#\n#   DESCRIPTION:\n#       `import math` for `math.sqrt(x)`, `from math import sqrt` for `sqrt(x)` (§16.6). The float\n#       functions are the C library's, declared here with the types Base gives them; the integer\n#       functions are Base.\n#\n#==============================================================================================\nextern func c_floor as \"floor\"(x: f64) -> f64\nextern func c_ceil as \"ceil\"(x: f64) -> f64\nextern func c_round as \"round\"(x: f64) -> f64\nextern func c_trunc as \"trunc\"(x: f64) -> f64\nextern func c_sqrt as \"sqrt\"(x: f64) -> f64\nextern func c_cbrt as \"cbrt\"(x: f64) -> f64\nextern func c_hypot as \"hypot\"(x: f64, y: f64) -> f64\nextern func c_fmod as \"fmod\"(x: f64, y: f64) -> f64\nextern func c_pow as \"pow\"(x: f64, y: f64) -> f64\nextern func c_exp as \"exp\"(x: f64) -> f64\nextern func c_exp2 as \"exp2\"(x: f64) -> f64\nextern func c_log as \"log\"(x: f64) -> f64\nextern func c_log2 as \"log2\"(x: f64) -> f64\nextern func c_log10 as \"log10\"(x: f64) -> f64\nextern func c_sin as \"sin\"(x: f64) -> f64\nextern func c_cos as \"cos\"(x: f64) -> f64\nextern func c_tan as \"tan\"(x: f64) -> f64\nextern func c_asin as \"asin\"(x: f64) -> f64\nextern func c_acos as \"acos\"(x: f64) -> f64\nextern func c_atan as \"atan\"(x: f64) -> f64\nextern func c_atan2 as \"atan2\"(y: f64, x: f64) -> f64\nextern func c_sinh as \"sinh\"(x: f64) -> f64\nextern func c_cosh as \"cosh\"(x: f64) -> f64\nextern func c_tanh as \"tanh\"(x: f64) -> f64\nextern func c_log1p as \"log1p\"(x: f64) -> f64\nextern func c_expm1 as \"expm1\"(x: f64) -> f64\nextern func c_fma as \"fma\"(x: f64, y: f64, z: f64) -> f64\nextern func c_fabs as \"fabs\"(x: f64) -> f64\nextern func c_nextafter as \"nextafter\"(x: f64, toward: f64) -> f64\nextern func c_frexp as \"frexp\"(x: f64, out exponent: i32) -> f64\nextern func c_scalbn as \"scalbn\"(x: f64, exponent: i32) -> f64\nextern func c_modf as \"modf\"(x: f64, out integral: f64) -> f64\nextern func c_remainder as \"remainder\"(x: f64, y: f64) -> f64\n## The ratio of a circle's circumference to its diameter.\npub let pi: f64 = 3.141592653589793\n## A full turn in radians, two pi.\npub let tau: f64 = 6.283185307179586\n## Euler's number.\npub let e: f64 = 2.718281828459045\n## Built from bits so that no constant expression needs to overflow.\npub let infinity: f64 = f64.bits(9218868437227405312)\n## A quiet not-a-number; unequal to everything, itself included.\npub let nan: f64 = f64.bits(9221120237041090560)\n\nlet sign_mask: u64 = 0x8000000000000000\nlet magnitude_mask: u64 = 0x7fffffffffffffff\nlet exponent_mask: u64 = 0x7ff0000000000000\n\n# mark: Real functions ========================================================================\n\n## Rounding: `floor` toward negative infinity, `ceil` toward positive, `round` to the\n## nearest with halves away from zero, `trunc` toward zero.\npub func floor(x: f64) -> f64:\n    return c_floor(x)\n\n## The smallest integer value not less than `x`.\npub func ceil(x: f64) -> f64:\n    return c_ceil(x)\n\n## `x` rounded to the nearest integer, halves away from zero.\npub func round(x: f64) -> f64:\n    return c_round(x)\n\n## `x` with its fractional part removed, toward zero.\npub func trunc(x: f64) -> f64:\n    return c_trunc(x)\n\n## The square root of `x`.\npub func sqrt(x: f64) -> f64:\n    return c_sqrt(x)\n\n## The cube root of `x`.\npub func cbrt(x: f64) -> f64:\n    return c_cbrt(x)\n\n## `sqrt(x * x + y * y)` without overflow in the squares.\npub func hypot(x: f64, y: f64) -> f64:\n    return c_hypot(x, y)\n\n## The remainder of `x / y` with the sign of `x`, as C's `fmod`; a zero has the sign of `x`.\npub func mod(x: f64, y: f64) -> f64:\n    let result = c_fmod(x, y)\n    # MinGW's fmod loses the dividend's zero sign under directed rounding, as some\n    # hosts' remainder does: restore it by bits, leaving a nonzero or NaN result.\n    return copysign(result, x) if (result.bits() & magnitude_mask) == 0 else result\n\n## `x` raised to the power `y`.\npub func pow(x: f64, y: f64) -> f64:\n    return c_pow(x, y)\n\n## `e` raised to the power `x`.\npub func exp(x: f64) -> f64:\n    return c_exp(x)\n\n## `2` raised to the power `x`.\npub func exp2(x: f64) -> f64:\n    return c_exp2(x)\n\n## The natural logarithm of `x`.\npub func log(x: f64) -> f64:\n    return c_log(x)\n\n## The base-2 logarithm of `x`.\npub func log2(x: f64) -> f64:\n    return c_log2(x)\n\n## The base-10 logarithm of `x`.\npub func log10(x: f64) -> f64:\n    return c_log10(x)\n\n## Natural logarithm of `1 + x`, retaining accuracy when adding `x` to one would\n## round it away. At -1 the result is negative infinity; below -1 it is NaN.\npub func log1p(x: f64) -> f64:\n    return c_log1p(x)\n\n## `exp(x) - 1` without cancellation near zero. Signed zero is preserved.\npub func expm1(x: f64) -> f64:\n    # The exact limit is representable in every rounding mode. Some host libm\n    # implementations instead round a finite-input approximation toward -1.\n    if x.bits() == (sign_mask | exponent_mask):\n        return -1.0\n    return c_expm1(x)\n\n## Multiply `x * y` and add `z` with one final rounding, rather than rounding the\n## product first. Uses the host's floating-point rounding mode.\npub func fma(x: f64, y: f64, z: f64) -> f64:\n    return c_fma(x, y, z)\n\n## The adjacent representable value toward `toward`; equal arguments return\n## `toward`, including its zero sign. A NaN argument produces NaN.\npub func nextafter(x: f64, toward: f64) -> f64:\n    return c_nextafter(x, toward)\n\n## The adjacent representable value toward positive infinity. Positive infinity\n## stays infinite; either zero becomes the smallest positive subnormal.\npub func next_up(x: f64) -> f64:\n    return c_nextafter(x, infinity)\n\n## The adjacent representable value toward negative infinity. Negative infinity\n## stays infinite; either zero becomes the smallest negative subnormal.\npub func next_down(x: f64) -> f64:\n    return c_nextafter(x, copysign(infinity, -1.0))\n\n## Split `x` into `(fraction, exponent)` such that `x = fraction * 2**exponent`.\n## A finite nonzero fraction has magnitude in [0.5, 1). Zero, infinity and NaN\n## are returned unchanged with exponent zero, avoiding an unspecified C exponent.\npub func frexp(x: f64) -> (f64, i32):\n    if x == 0.0 or not is_finite(x):\n        return (x, 0)\n    return c_frexp(x)\n\n## Scale by an integer power of two, without forming that power as an intermediate\n## float. Overflow/underflow follow the host rounding mode; signed zero survives.\npub func scalbn(x: f64, exponent: i32) -> f64:\n    return c_scalbn(x, exponent)\n\n## `(fractional, integral)` parts, both with the sign of `x`; the integral part\n## truncates toward zero. Infinity has a signed-zero fraction; NaN gives two NaNs.\npub func modf(x: f64) -> (f64, f64):\n    return c_modf(x)\n\n## `x - n*y` for the nearest integer `n` to `x/y`, with ties choosing even `n`.\n## This differs from `mod`, which truncates the quotient. Zero has the sign of `x`;\n## a zero divisor or infinite dividend produces NaN.\npub func remainder(x: f64, y: f64) -> f64:\n    let result = c_remainder(x, y)\n    # Some host implementations lose the dividend's zero sign under directed\n    # rounding. Restore it by bits without changing a nonzero or NaN result.\n    return copysign(result, x) if (result.bits() & magnitude_mask) == 0 else result\n\n## The sine of `x` radians.\npub func sin(x: f64) -> f64:\n    return c_sin(x)\n\n## The cosine of `x` radians.\npub func cos(x: f64) -> f64:\n    return c_cos(x)\n\n## The tangent of `x` radians.\npub func tan(x: f64) -> f64:\n    return c_tan(x)\n\n## The arcsine of `x`, in radians.\npub func asin(x: f64) -> f64:\n    return c_asin(x)\n\n## The arccosine of `x`, in radians.\npub func acos(x: f64) -> f64:\n    return c_acos(x)\n\n## The arctangent of `x`, in radians.\npub func atan(x: f64) -> f64:\n    return c_atan(x)\n\n## The angle of the point `(x, y)`, in all four quadrants.\npub func atan2(y: f64, x: f64) -> f64:\n    return c_atan2(y, x)\n\n## The hyperbolic sine of `x`.\npub func sinh(x: f64) -> f64:\n    return c_sinh(x)\n\n## The hyperbolic cosine of `x`.\npub func cosh(x: f64) -> f64:\n    return c_cosh(x)\n\n## The hyperbolic tangent of `x`.\npub func tanh(x: f64) -> f64:\n    return c_tanh(x)\n\n# erf and erfc follow the method of Sun's fdlibm (s_erf.c, as in FreeBSD's msun), written\n# anew in Base: a rational approximation in x² below 0.84375, one in |x| - 1 up to 1.25,\n# and above that erfc(x) = exp(-x² - 0.5625 + R(1/x²)/S(1/x²)) / x with two rational fits\n# split at 1/0.35. The coefficients are fdlibm's. Results are within two units in the last\n# place (tests/math_accuracy holds the evidence); the only host function used is exp.\n\n## erf(1) in 24 bits, which the middle interval adds to; being short, `erx + P/Q` and\n## `1 - erx - P/Q` round once.\nlet erx: f64 = 8.45062911510467529297e-01\n## 2/sqrt(pi) - 1, the slope of erf at zero beyond x.\nlet efx: f64 = 1.28379167095512586316e-01\n\n## erf(x) = x + x·P(x²)/Q(x²) on [0, 0.84375).\nfunc erf_small(x: f64) -> f64:\n    let z = x * x\n    let p = 1.28379167095512558561e-01 + z * (-3.25042107247001499370e-01 + z * (-2.84817495755985104766e-02 + z * (-5.77027029648944159157e-03 + z * -2.37630166566501626084e-05)))\n    let q = 1.0 + z * (3.97917223959155352819e-01 + z * (6.50222499887672944485e-02 + z * (5.08130628187576562776e-03 + z * (1.32494738004321644526e-04 + z * -3.96022827877536812320e-06))))\n    return p / q\n\n## erf(1 + s) - erx = P(s)/Q(s) on [0.84375, 1.25).\nfunc erf_middle(s: f64) -> f64:\n    let p = -2.36211856075265944077e-03 + s * (4.14856118683748331666e-01 + s * (-3.72207876035701323847e-01 + s * (3.18346619901161753674e-01 + s * (-1.10894694282396677476e-01 + s * (3.54783043256182359371e-02 + s * -2.16637559486879084300e-03)))))\n    let q = 1.0 + s * (1.06420880400844228286e-01 + s * (5.40397917702171048937e-01 + s * (7.18286544141962662868e-02 + s * (1.26171219808761642112e-01 + s * (1.36370839120290507362e-02 + s * 1.19844998467991074170e-02)))))\n    return p / q\n\n## erfc(a) for 1.25 <= a < 28: exp(-a² - 0.5625 + R/S) / a. The square is split at a with\n## its low 32 bits cleared, whose square is exact, so the exponent loses nothing.\nfunc erfc_tail(a: f64) -> f64:\n    let s = 1.0 / (a * a)\n    var r: f64\n    var q: f64\n    if a < 2.857142857142857:\n        r = -9.86494403484714822705e-03 + s * (-6.93858572707181764372e-01 + s * (-1.05586262253232909814e+01 + s * (-6.23753324503260060396e+01 + s * (-1.62396669462573470355e+02 + s * (-1.84605092906711035994e+02 + s * (-8.12874355063065934246e+01 + s * -9.81432934416914548592e+00))))))\n        q = 1.0 + s * (1.96512716674392571292e+01 + s * (1.37657754143519042600e+02 + s * (4.34565877475229228821e+02 + s * (6.45387271733267880336e+02 + s * (4.29008140027567833386e+02 + s * (1.08635005541779435134e+02 + s * (6.57024977031928170135e+00 + s * -6.04244152148580987438e-02)))))))\n    else:\n        r = -9.86494292470009928597e-03 + s * (-7.99283237680523006574e-01 + s * (-1.77579549177547519889e+01 + s * (-1.60636384855821916062e+02 + s * (-6.37566443368389627722e+02 + s * (-1.02509513161107724954e+03 + s * -4.83519191608651397019e+02)))))\n        q = 1.0 + s * (3.03380607434824582924e+01 + s * (3.25792512996573918826e+02 + s * (1.53672958608443695994e+03 + s * (3.19985821950859553908e+03 + s * (2.55305040643316442583e+03 + s * (4.74528541206955367215e+02 + s * -2.24409524465858183362e+01))))))\n    let z = f64.bits(a.bits() & 0xffffffff00000000)\n    return c_exp(-z * z - 0.5625) * c_exp((z - a) * (z + a) + r / q) / a\n\n## The error function, (2/√π)∫₀ˣ e^(-t²) dt, as Python's `math.erf`: odd, from -1 to 1.\n## Signed zero is preserved; infinities give ±1 and NaN gives NaN.\npub func erf(x: f64) -> f64:\n    let a = abs(x)\n    if not (a < 6.0):\n        if is_nan(x):\n            return x\n        return copysign(1.0, x)\n    if a < 0.84375:\n        if a < 3.725290298461914e-09:\n            # below 2^-28 the series is x + efx·x; scaling by 8 keeps subnormals exact\n            return 0.125 * (8.0 * x + (8.0 * efx) * x)\n        return x + x * erf_small(x)\n    let magnitude = erx + erf_middle(a - 1.0) if a < 1.25 else 1.0 - erfc_tail(a)\n    return copysign(magnitude, x)\n\n## The complementary error function, `1 - erf(x)`, as Python's `math.erfc`: accurate where\n## erf(x) is near 1 and the subtraction would lose every digit. It falls from 2 to 0 and\n## underflows to zero above about 27.2; infinities give 0 and 2, NaN gives NaN.\npub func erfc(x: f64) -> f64:\n    let a = abs(x)\n    if a < 0.84375:\n        if a < 1.3877787807814457e-17:\n            return 1.0 - x\n        let y = x * erf_small(x)\n        if x < 0.25:\n            return 1.0 - (x + y)\n        return 0.5 - (y + (x - 0.5))\n    if a < 1.25:\n        let p = erf_middle(a - 1.0)\n        return (1.0 - erx) - p if x > 0.0 else 1.0 + (erx + p)\n    if a < 28.0:\n        if x < -6.0:\n            return 2.0\n        let r = erfc_tail(a)\n        return r if x > 0.0 else 2.0 - r\n    if is_nan(x):\n        return x\n    return 0.0 if x > 0.0 else 2.0\n\n## True for quiet and signaling NaNs, independent of sign and payload.\npub func is_nan(x: f64) -> bool:\n    return (x.bits() & magnitude_mask) > exponent_mask\n\n## True for zeros, subnormals and normal finite values. Classification inspects the\n## representation and performs no floating-point arithmetic on a signaling NaN.\npub func is_finite(x: f64) -> bool:\n    return (x.bits() & exponent_mask) != exponent_mask\n\n## True only for positive or negative infinity.\npub func is_infinite(x: f64) -> bool:\n    return (x.bits() & magnitude_mask) == exponent_mask\n\n## Whether the sign bit is set, including negative zero and signed NaNs.\npub func signbit(x: f64) -> bool:\n    return (x.bits() & sign_mask) != 0\n\n## Clear the sign bit: negative zero becomes positive zero. NaN payload bits survive.\npub func abs(x: f64) -> f64:\n    return c_fabs(x)\n\n## The magnitude and payload of `magnitude` with the sign bit of `sign_source`.\npub func copysign(magnitude: f64, sign_source: f64) -> f64:\n    return f64.bits((magnitude.bits() & magnitude_mask) | (sign_source.bits() & sign_mask))\n\n## `-1.0` or `1.0` for nonzero numbers; zero and NaN are returned unchanged.\npub func sign(x: f64) -> f64:\n    if is_nan(x):\n        return x\n    if x < 0.0:\n        return -1.0\n    if x > 0.0:\n        return 1.0\n    return x\n\n## Minimum with NaN propagation (left NaN wins if both are NaNs). Negative zero\n## wins over positive zero; a selected NaN retains its original bits.\npub func min(a: f64, b: f64) -> f64:\n    if is_nan(a):\n        return a\n    if is_nan(b):\n        return b\n    if a == 0.0 and b == 0.0:\n        return f64.bits(a.bits() | b.bits())\n    return a if a < b else b\n\n## Maximum with NaN propagation (left NaN wins if both are NaNs). Positive zero\n## wins over negative zero; a selected NaN retains its original bits.\npub func max(a: f64, b: f64) -> f64:\n    if is_nan(a):\n        return a\n    if is_nan(b):\n        return b\n    if a == 0.0 and b == 0.0:\n        return f64.bits(a.bits() & b.bits())\n    return a if a > b else b\n\n## Restrict `x` to inclusive ordered bounds. Reversed or NaN bounds trap. An input\n## NaN or an input equal to a bound is returned unchanged, including its zero sign.\npub func clamp(x: f64, low: f64, high: f64) -> f64:\n    assert(low <= high)\n    if is_nan(x):\n        return x\n    return low if x < low else (high if x > high else x)\n\n## The integer functions. `//` and `%` truncate toward zero as C does (§7.2); these two\n## floor, so `div_floor(-7, 2)` is `-4` and `mod_floor(-7, 2)` is `1`.\npub func div_floor(a: i64, b: i64) -> i64:\n    let q = a // b\n    if (a % b != 0) and ((a < 0) != (b < 0)):\n        return q - 1\n    return q\n\n## The remainder of `a / b` with the divisor's sign (floored division).\npub func mod_floor(a: i64, b: i64) -> i64:\n    if b == -1:\n        return 0\n    let r = a % b\n    if r != 0 and ((r < 0) != (b < 0)):\n        return r + b\n    return r\n\n## The absolute value of `a`; the minimum i64 wraps to itself.\npub func iabs(a: i64) -> i64:\n    return 0 - a if a < 0 else a\n\n## Absolute value, or none for the minimum i64 whose positive magnitude cannot fit.\npub func checked_iabs(a: i64) -> i64?:\n    if a < 0:\n        return 0 -? a\n    return a\n\n## Floor division, or none for a zero divisor or a quotient outside i64.\npub func checked_div_floor(a: i64, b: i64) -> i64?:\n    if b == 0 or (a == -9223372036854775808 and b == -1):\n        return none\n    return div_floor(a, b)\n\n## Remainder with the divisor's sign, or none for a zero divisor. The minimum i64\n## modulo -1 is zero even though its quotient cannot be represented.\npub func checked_mod_floor(a: i64, b: i64) -> i64?:\n    if b == 0:\n        return none\n    if b == -1:\n        return 0\n    return mod_floor(a, b)\n\n## The smaller of `a` and `b`.\npub func imin(a: i64, b: i64) -> i64:\n    return a if a < b else b\n\n## The larger of `a` and `b`.\npub func imax(a: i64, b: i64) -> i64:\n    return a if a > b else b\n\n## Restrict `x` to inclusive ordered bounds. Reversed bounds trap.\npub func iclamp(x: i64, low: i64, high: i64) -> i64:\n    assert(low <= high)\n    return low if x < low else (high if x > high else x)\n",
    "#==============================================================================================\n#\n#   math32 - Single-precision mathematical functions\n#\n#   DESCRIPTION:\n#       Single-precision mathematics. `math32` has the floating-point operations of `math`, with\n#       f32 arguments and results and the same special-value contracts. Elementary functions\n#       call the host's single-precision libm entry points directly; they do not compute in f64\n#       and then introduce an extra rounding step. `erf` and `erfc` are the exception: they are\n#       `math`'s, rounded once to f32.\n#\n#==============================================================================================\nimport math\nextern func c_floor as \"floorf\"(x: f32) -> f32\nextern func c_ceil as \"ceilf\"(x: f32) -> f32\nextern func c_round as \"roundf\"(x: f32) -> f32\nextern func c_trunc as \"truncf\"(x: f32) -> f32\nextern func c_sqrt as \"sqrtf\"(x: f32) -> f32\nextern func c_cbrt as \"cbrtf\"(x: f32) -> f32\nextern func c_hypot as \"hypotf\"(x: f32, y: f32) -> f32\nextern func c_fmod as \"fmodf\"(x: f32, y: f32) -> f32\nextern func c_pow as \"powf\"(x: f32, y: f32) -> f32\nextern func c_exp as \"expf\"(x: f32) -> f32\nextern func c_exp2 as \"exp2f\"(x: f32) -> f32\nextern func c_log as \"logf\"(x: f32) -> f32\nextern func c_log2 as \"log2f\"(x: f32) -> f32\nextern func c_log10 as \"log10f\"(x: f32) -> f32\nextern func c_sin as \"sinf\"(x: f32) -> f32\nextern func c_cos as \"cosf\"(x: f32) -> f32\nextern func c_tan as \"tanf\"(x: f32) -> f32\nextern func c_asin as \"asinf\"(x: f32) -> f32\nextern func c_acos as \"acosf\"(x: f32) -> f32\nextern func c_atan as \"atanf\"(x: f32) -> f32\nextern func c_atan2 as \"atan2f\"(y: f32, x: f32) -> f32\nextern func c_sinh as \"sinhf\"(x: f32) -> f32\nextern func c_cosh as \"coshf\"(x: f32) -> f32\nextern func c_tanh as \"tanhf\"(x: f32) -> f32\nextern func c_log1p as \"log1pf\"(x: f32) -> f32\nextern func c_expm1 as \"expm1f\"(x: f32) -> f32\nextern func c_fma as \"fmaf\"(x: f32, y: f32, z: f32) -> f32\nextern func c_fabs as \"fabsf\"(x: f32) -> f32\nextern func c_nextafter as \"nextafterf\"(x: f32, toward: f32) -> f32\nextern func c_frexp as \"frexpf\"(x: f32, out exponent: i32) -> f32\nextern func c_scalbn as \"scalbnf\"(x: f32, exponent: i32) -> f32\nextern func c_modf as \"modff\"(x: f32, out integral: f32) -> f32\nextern func c_remainder as \"remainderf\"(x: f32, y: f32) -> f32\n## The ratio of a circle's circumference to its diameter.\npub let pi: f32 = 3.141592653589793\n## A full turn in radians, two pi.\npub let tau: f32 = 6.283185307179586\n## Euler's number.\npub let e: f32 = 2.718281828459045\n## Built from bits so that no constant expression needs to overflow.\npub let infinity: f32 = f32.bits(2139095040)\n## A quiet not-a-number; unequal to everything, itself included.\npub let nan: f32 = f32.bits(2143289344)\n\nlet sign_mask: u32 = 0x80000000\nlet magnitude_mask: u32 = 0x7fffffff\nlet exponent_mask: u32 = 0x7f800000\n\n# mark: Real functions ========================================================================\n\n## Rounding: `floor` toward negative infinity, `ceil` toward positive, `round` to the\n## nearest with halves away from zero, `trunc` toward zero.\npub func floor(x: f32) -> f32:\n    return c_floor(x)\n\n## The smallest integer value not less than `x`.\npub func ceil(x: f32) -> f32:\n    return c_ceil(x)\n\n## `x` rounded to the nearest integer, halves away from zero.\npub func round(x: f32) -> f32:\n    return c_round(x)\n\n## `x` with its fractional part removed, toward zero.\npub func trunc(x: f32) -> f32:\n    return c_trunc(x)\n\n## The square root of `x`.\npub func sqrt(x: f32) -> f32:\n    return c_sqrt(x)\n\n## The cube root of `x`.\npub func cbrt(x: f32) -> f32:\n    return c_cbrt(x)\n\n## `sqrt(x * x + y * y)` without overflow in the squares.\npub func hypot(x: f32, y: f32) -> f32:\n    return c_hypot(x, y)\n\n## The remainder of `x / y` with the sign of `x`, as C's `fmod`; a zero has the sign of `x`.\npub func mod(x: f32, y: f32) -> f32:\n    let result = c_fmod(x, y)\n    # MinGW's fmod loses the dividend's zero sign under directed rounding, as some\n    # hosts' remainder does: restore it by bits, leaving a nonzero or NaN result.\n    return copysign(result, x) if (result.bits() & magnitude_mask) == 0 else result\n\n## `x` raised to the power `y`.\npub func pow(x: f32, y: f32) -> f32:\n    return c_pow(x, y)\n\n## `e` raised to the power `x`.\npub func exp(x: f32) -> f32:\n    return c_exp(x)\n\n## `2` raised to the power `x`.\npub func exp2(x: f32) -> f32:\n    return c_exp2(x)\n\n## The natural logarithm of `x`.\npub func log(x: f32) -> f32:\n    return c_log(x)\n\n## The base-2 logarithm of `x`.\npub func log2(x: f32) -> f32:\n    return c_log2(x)\n\n## The base-10 logarithm of `x`.\npub func log10(x: f32) -> f32:\n    return c_log10(x)\n\n## Natural logarithm of `1 + x`, retaining accuracy when adding `x` to one would\n## round it away. At -1 the result is negative infinity; below -1 it is NaN.\npub func log1p(x: f32) -> f32:\n    return c_log1p(x)\n\n## `exp(x) - 1` without cancellation near zero. Signed zero is preserved.\npub func expm1(x: f32) -> f32:\n    # Preserve the exact negative-infinity limit under directed rounding too.\n    if x.bits() == (sign_mask | exponent_mask):\n        return -1.0\n    return c_expm1(x)\n\n## Multiply `x * y` and add `z` with one final rounding, rather than rounding the\n## product first. Uses the host's floating-point rounding mode.\npub func fma(x: f32, y: f32, z: f32) -> f32:\n    return c_fma(x, y, z)\n\n## The adjacent representable value toward `toward`; equal arguments return\n## `toward`, including its zero sign. A NaN argument produces NaN.\npub func nextafter(x: f32, toward: f32) -> f32:\n    return c_nextafter(x, toward)\n\n## The adjacent representable value toward positive infinity. Positive infinity\n## stays infinite; either zero becomes the smallest positive subnormal.\npub func next_up(x: f32) -> f32:\n    return c_nextafter(x, infinity)\n\n## The adjacent representable value toward negative infinity. Negative infinity\n## stays infinite; either zero becomes the smallest negative subnormal.\npub func next_down(x: f32) -> f32:\n    return c_nextafter(x, copysign(infinity, -1.0))\n\n## Split `x` into `(fraction, exponent)` such that `x = fraction * 2**exponent`.\n## A finite nonzero fraction has magnitude in [0.5, 1). Zero, infinity and NaN\n## are returned unchanged with exponent zero, avoiding an unspecified C exponent.\npub func frexp(x: f32) -> (f32, i32):\n    if x == 0.0 or not is_finite(x):\n        return (x, 0)\n    return c_frexp(x)\n\n## Scale by an integer power of two, without forming that power as an intermediate\n## float. Overflow/underflow follow the host rounding mode; signed zero survives.\npub func scalbn(x: f32, exponent: i32) -> f32:\n    return c_scalbn(x, exponent)\n\n## `(fractional, integral)` parts, both with the sign of `x`; the integral part\n## truncates toward zero. Infinity has a signed-zero fraction; NaN gives two NaNs.\npub func modf(x: f32) -> (f32, f32):\n    return c_modf(x)\n\n## `x - n*y` for the nearest integer `n` to `x/y`, with ties choosing even `n`.\n## This differs from `mod`, which truncates the quotient. Zero has the sign of `x`;\n## a zero divisor or infinite dividend produces NaN.\npub func remainder(x: f32, y: f32) -> f32:\n    let result = c_remainder(x, y)\n    # Match the f64 contract even if a host loses the zero sign while rounding.\n    return copysign(result, x) if (result.bits() & magnitude_mask) == 0 else result\n\n## The sine of `x` radians.\npub func sin(x: f32) -> f32:\n    return c_sin(x)\n\n## The cosine of `x` radians.\npub func cos(x: f32) -> f32:\n    return c_cos(x)\n\n## The tangent of `x` radians.\npub func tan(x: f32) -> f32:\n    return c_tan(x)\n\n## The arcsine of `x`, in radians.\npub func asin(x: f32) -> f32:\n    return c_asin(x)\n\n## The arccosine of `x`, in radians.\npub func acos(x: f32) -> f32:\n    return c_acos(x)\n\n## The arctangent of `x`, in radians.\npub func atan(x: f32) -> f32:\n    return c_atan(x)\n\n## The angle of the point `(x, y)`, in all four quadrants.\npub func atan2(y: f32, x: f32) -> f32:\n    return c_atan2(y, x)\n\n## The hyperbolic sine of `x`.\npub func sinh(x: f32) -> f32:\n    return c_sinh(x)\n\n## The hyperbolic cosine of `x`.\npub func cosh(x: f32) -> f32:\n    return c_cosh(x)\n\n## The hyperbolic tangent of `x`.\npub func tanh(x: f32) -> f32:\n    return c_tanh(x)\n\n## The error function, as `math.erf`, evaluated in f64 and rounded once to f32: within a\n## unit in the last place.\npub func erf(x: f32) -> f32:\n    return (f32)math.erf((f64)x)\n\n## The complementary error function, `1 - erf(x)` without cancellation, as `math.erfc`,\n## evaluated in f64 and rounded once to f32.\npub func erfc(x: f32) -> f32:\n    return (f32)math.erfc((f64)x)\n\n## True for quiet and signaling NaNs, independent of sign and payload.\npub func is_nan(x: f32) -> bool:\n    return (x.bits() & magnitude_mask) > exponent_mask\n\n## True for zeros, subnormals and normal finite values. Classification inspects the\n## representation and performs no floating-point arithmetic on a signaling NaN.\npub func is_finite(x: f32) -> bool:\n    return (x.bits() & exponent_mask) != exponent_mask\n\n## True only for positive or negative infinity.\npub func is_infinite(x: f32) -> bool:\n    return (x.bits() & magnitude_mask) == exponent_mask\n\n## Whether the sign bit is set, including negative zero and signed NaNs.\npub func signbit(x: f32) -> bool:\n    return (x.bits() & sign_mask) != 0\n\n## Clear the sign bit: negative zero becomes positive zero. NaN payload bits survive.\npub func abs(x: f32) -> f32:\n    return c_fabs(x)\n\n## The magnitude and payload of `magnitude` with the sign bit of `sign_source`.\npub func copysign(magnitude: f32, sign_source: f32) -> f32:\n    return f32.bits((magnitude.bits() & magnitude_mask) | (sign_source.bits() & sign_mask))\n\n## `-1.0` or `1.0` for nonzero numbers; zero and NaN are returned unchanged.\npub func sign(x: f32) -> f32:\n    if is_nan(x):\n        return x\n    if x < 0.0:\n        return -1.0\n    if x > 0.0:\n        return 1.0\n    return x\n\n## Minimum with NaN propagation (left NaN wins if both are NaNs). Negative zero\n## wins over positive zero; a selected NaN retains its original bits.\npub func min(a: f32, b: f32) -> f32:\n    if is_nan(a):\n        return a\n    if is_nan(b):\n        return b\n    if a == 0.0 and b == 0.0:\n        return f32.bits(a.bits() | b.bits())\n    return a if a < b else b\n\n## Maximum with NaN propagation (left NaN wins if both are NaNs). Positive zero\n## wins over negative zero; a selected NaN retains its original bits.\npub func max(a: f32, b: f32) -> f32:\n    if is_nan(a):\n        return a\n    if is_nan(b):\n        return b\n    if a == 0.0 and b == 0.0:\n        return f32.bits(a.bits() & b.bits())\n    return a if a > b else b\n\n## Restrict `x` to inclusive ordered bounds. Reversed or NaN bounds trap. An input\n## NaN or an input equal to a bound is returned unchanged, including its zero sign.\npub func clamp(x: f32, low: f32, high: f32) -> f32:\n    assert(low <= high)\n    if is_nan(x):\n        return x\n    return low if x < low else (high if x > high else x)\n",
]
