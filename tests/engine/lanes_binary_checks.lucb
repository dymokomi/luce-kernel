# Generated by tools/lanes.py from its tables; edit those, not this file.
# Unit checks of every binary operation in every width.

test "add in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f32: f32[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    var d_f32: f32[8]
    assert(try binary_case(.add, .f32, a_f32, b_f32, d_f32, .f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], a_f32[i] + b_f32[i]))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f64: f64[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    var d_f64: f64[8]
    assert(try binary_case(.add, .f64, a_f64, b_f64, d_f64, .f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], a_f64[i] + b_f64[i]))
    let a_i32: i32[8] = [0, 1, -7, 100, -1000, 12345, 77, -2]
    let b_i32: i32[8] = [1, 2, 3, -4, 5, 6, 7, 8]
    var d_i32: i32[8]
    assert(try binary_case(.add, .i32, a_i32, b_i32, d_i32, .i32) == none)
    for i in 0..<8: assert(d_i32[i] == (a_i32[i] + b_i32[i]))
    let a_i64: i64[8] = [0, 1, -7, 100, -1000, 12345, 77, -2]
    let b_i64: i64[8] = [1, 2, 3, -4, 5, 6, 7, 8]
    var d_i64: i64[8]
    assert(try binary_case(.add, .i64, a_i64, b_i64, d_i64, .i64) == none)
    for i in 0..<8: assert(d_i64[i] == (a_i64[i] + b_i64[i]))
    let a_u32: u32[8] = [10, 11, 70, 100, 1000, 12345, 77, 9]
    let b_u32: u32[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var d_u32: u32[8]
    assert(try binary_case(.add, .u32, a_u32, b_u32, d_u32, .u32) == none)
    for i in 0..<8: assert(d_u32[i] == (a_u32[i] + b_u32[i]))
    let a_u64: u64[8] = [10, 11, 70, 100, 1000, 12345, 77, 9]
    let b_u64: u64[8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var d_u64: u64[8]
    assert(try binary_case(.add, .u64, a_u64, b_u64, d_u64, .u64) == none)
    for i in 0..<8: assert(d_u64[i] == (a_u64[i] + b_u64[i]))

