test "mul_add in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f32: f32[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f32: f32[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f32: f32[8]
    assert(try ternary_case(.mul_add, .f32, a_f32, b_f32, c_f32, d_f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], a_f32[i].mul_add(b_f32[i], c_f32[i])))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f64: f64[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f64: f64[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f64: f64[8]
    assert(try ternary_case(.mul_add, .f64, a_f64, b_f64, c_f64, d_f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], a_f64[i].mul_add(b_f64[i], c_f64[i])))

test "lerp in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f32: f32[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f32: f32[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f32: f32[8]
    assert(try ternary_case(.lerp, .f32, a_f32, b_f32, c_f32, d_f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], lib.lerp(a_f32[i], b_f32[i], c_f32[i])))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f64: f64[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f64: f64[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f64: f64[8]
    assert(try ternary_case(.lerp, .f64, a_f64, b_f64, c_f64, d_f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], lib.lerp64(a_f64[i], b_f64[i], c_f64[i])))

test "clamp in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f32: f32[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f32: f32[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f32: f32[8]
    assert(try ternary_case(.clamp, .f32, a_f32, b_f32, c_f32, d_f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], b_f32[i] if a_f32[i] < b_f32[i] else (c_f32[i] if a_f32[i] > c_f32[i] else a_f32[i])))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f64: f64[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f64: f64[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f64: f64[8]
    assert(try ternary_case(.clamp, .f64, a_f64, b_f64, c_f64, d_f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], b_f64[i] if a_f64[i] < b_f64[i] else (c_f64[i] if a_f64[i] > c_f64[i] else a_f64[i])))
    let a_i32: i32[8] = [0, 1, -7, 100, -1000, 12345, 77, -2]
    let b_i32: i32[8] = [-5, -5, -5, -5, -5, -5, -5, -5]
    let c_i32: i32[8] = [50, 50, 50, 50, 50, 50, 50, 50]
    var d_i32: i32[8]
    assert(try ternary_case(.clamp, .i32, a_i32, b_i32, c_i32, d_i32) == none)
    for i in 0..<8: assert(d_i32[i] == (b_i32[i] if a_i32[i] < b_i32[i] else (c_i32[i] if a_i32[i] > c_i32[i] else a_i32[i])))
    let a_i64: i64[8] = [0, 1, -7, 100, -1000, 12345, 77, -2]
    let b_i64: i64[8] = [-5, -5, -5, -5, -5, -5, -5, -5]
    let c_i64: i64[8] = [50, 50, 50, 50, 50, 50, 50, 50]
    var d_i64: i64[8]
    assert(try ternary_case(.clamp, .i64, a_i64, b_i64, c_i64, d_i64) == none)
    for i in 0..<8: assert(d_i64[i] == (b_i64[i] if a_i64[i] < b_i64[i] else (c_i64[i] if a_i64[i] > c_i64[i] else a_i64[i])))
    let a_u32: u32[8] = [10, 11, 70, 100, 1000, 12345, 77, 9]
    let b_u32: u32[8] = [5, 5, 5, 5, 5, 5, 5, 5]
    let c_u32: u32[8] = [50, 50, 50, 50, 50, 50, 50, 50]
    var d_u32: u32[8]
    assert(try ternary_case(.clamp, .u32, a_u32, b_u32, c_u32, d_u32) == none)
    for i in 0..<8: assert(d_u32[i] == (b_u32[i] if a_u32[i] < b_u32[i] else (c_u32[i] if a_u32[i] > c_u32[i] else a_u32[i])))
    let a_u64: u64[8] = [10, 11, 70, 100, 1000, 12345, 77, 9]
    let b_u64: u64[8] = [5, 5, 5, 5, 5, 5, 5, 5]
    let c_u64: u64[8] = [50, 50, 50, 50, 50, 50, 50, 50]
    var d_u64: u64[8]
    assert(try ternary_case(.clamp, .u64, a_u64, b_u64, c_u64, d_u64) == none)
    for i in 0..<8: assert(d_u64[i] == (b_u64[i] if a_u64[i] < b_u64[i] else (c_u64[i] if a_u64[i] > c_u64[i] else a_u64[i])))

test "smooth in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f32: f32[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f32: f32[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f32: f32[8]
    assert(try ternary_case(.smooth, .f32, a_f32, b_f32, c_f32, d_f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], lib.smooth(a_f32[i], b_f32[i], c_f32[i])))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f64: f64[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f64: f64[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f64: f64[8]
    assert(try ternary_case(.smooth, .f64, a_f64, b_f64, c_f64, d_f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], lib.smooth64(a_f64[i], b_f64[i], c_f64[i])))

test "fit01 in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f32: f32[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f32: f32[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f32: f32[8]
    assert(try ternary_case(.fit01, .f32, a_f32, b_f32, c_f32, d_f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], lib.fit01(a_f32[i], b_f32[i], c_f32[i])))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    let b_f64: f64[8] = [1.0, 2.0, -0.5, 4.0, -8.0, 0.25, 3.0, 0.5]
    let c_f64: f64[8] = [2.0, 3.0, 0.5, 8.0, 1.0, 0.75, 9.0, 1.5]
    var d_f64: f64[8]
    assert(try ternary_case(.fit01, .f64, a_f64, b_f64, c_f64, d_f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], lib.fit01_64(a_f64[i], b_f64[i], c_f64[i])))
