    for i in 0..<8: assert(d_f64_u32[i] == ((u32)a_f64_u32[i]))
    let a_f64_u64: f64[8] = [0.0, 1.0, 7.5, 100.25, 126.9, 42.0, 3.0, 0.5]
    var d_f64_u64: u64[8]
    assert(try conversion_case(.convert, .f64, .u64, a_f64_u64, d_f64_u64) == none)
    for i in 0..<8: assert(d_f64_u64[i] == ((u64)a_f64_u64[i]))

