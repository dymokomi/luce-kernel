    for i in 0..<8: assert(d_f32[i] == (u8)math32.is_infinite(a_f32[i]))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: u8[8]
    assert(try unary_case(.isinf, .f64, a_f64, d_f64, .mask) == none)
    for i in 0..<8: assert(d_f64[i] == (u8)math.is_infinite(a_f64[i]))

test "isfinite in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: u8[8]
    assert(try unary_case(.isfinite, .f32, a_f32, d_f32, .mask) == none)
    for i in 0..<8: assert(d_f32[i] == (u8)math32.is_finite(a_f32[i]))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: u8[8]
    assert(try unary_case(.isfinite, .f64, a_f64, d_f64, .mask) == none)
    for i in 0..<8: assert(d_f64[i] == (u8)math.is_finite(a_f64[i]))
