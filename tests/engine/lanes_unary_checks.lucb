    for i in 0..<8: assert(same_f64(d_f64[i], math.sign(a_f64[i])))

test "frac in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: f32[8]
    assert(try unary_case(.frac, .f32, a_f32, d_f32, .f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], a_f32[i] - math32.floor(a_f32[i])))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: f64[8]
    assert(try unary_case(.frac, .f64, a_f64, d_f64, .f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], a_f64[i] - math.floor(a_f64[i])))

test "degrees in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: f32[8]
    assert(try unary_case(.degrees, .f32, a_f32, d_f32, .f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], a_f32[i] * (180.0 / math32.pi)))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: f64[8]
    assert(try unary_case(.degrees, .f64, a_f64, d_f64, .f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], a_f64[i] * (180.0 / math.pi)))

test "radians in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: f32[8]
    assert(try unary_case(.radians, .f32, a_f32, d_f32, .f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], a_f32[i] * (math32.pi / 180.0)))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: f64[8]
    assert(try unary_case(.radians, .f64, a_f64, d_f64, .f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], a_f64[i] * (math.pi / 180.0)))

test "isnan in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: u8[8]
    assert(try unary_case(.isnan, .f32, a_f32, d_f32, .mask) == none)
    for i in 0..<8: assert(d_f32[i] == (u8)math32.is_nan(a_f32[i]))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: u8[8]
    assert(try unary_case(.isnan, .f64, a_f64, d_f64, .mask) == none)
    for i in 0..<8: assert(d_f64[i] == (u8)math.is_nan(a_f64[i]))

test "isinf in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: u8[8]
