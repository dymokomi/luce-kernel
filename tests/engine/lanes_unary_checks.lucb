# Unit checks of every unary and classifying operation in every width.

test "neg in every width":
    let a_f32: f32[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f32: f32[8]
    assert(try unary_case(.neg, .f32, a_f32, d_f32, .f32) == none)
    for i in 0..<8: assert(same_f32(d_f32[i], -a_f32[i]))
    let a_f64: f64[8] = [0.0, -0.0, 1.5, -2.25, 100.0, 0.001, 7.0, -3.5]
    var d_f64: f64[8]
    assert(try unary_case(.neg, .f64, a_f64, d_f64, .f64) == none)
    for i in 0..<8: assert(same_f64(d_f64[i], -a_f64[i]))
    let a_i32: i32[8] = [0, 1, -7, 100, -1000, 12345, 77, -2]
    var d_i32: i32[8]
    assert(try unary_case(.neg, .i32, a_i32, d_i32, .i32) == none)
    for i in 0..<8: assert(d_i32[i] == (-a_i32[i]))
    let a_i64: i64[8] = [0, 1, -7, 100, -1000, 12345, 77, -2]
    var d_i64: i64[8]
    assert(try unary_case(.neg, .i64, a_i64, d_i64, .i64) == none)
    for i in 0..<8: assert(d_i64[i] == (-a_i64[i]))

