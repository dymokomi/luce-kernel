## luce-kernel's heavier checks, run by `luc test` as a program: the fault suite, the
## benchmark snippets against plain Base, the fuzzer, and allocation failures.
## `--bench` runs the benchmarks instead (tests/bench/run.py).
import assist
import bench
import conformance
import faults
import fuzz
import library
import lowering

pub func main(arguments: str[]) -> i32!:
    if arguments.length > 1 and arguments[1] == "--bench":
        try bench.run_all()
        return 0
    try faults.run_all()
    try conformance.run_all()
    try fuzz.run_all()
    try lowering.run_all()
    try library.run_all()
    try assist.run_all()
    return 0
